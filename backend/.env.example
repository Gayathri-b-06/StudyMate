# Required AI generation settings. Copy to .env; never commit real credentials.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_QUIZ_API_KEY=your_groq_api_key_here
# Optional: defaults to GROQ_MODEL
GROQ_QUIZ_MODEL=openai/gpt-oss-20b

# Local CPU retrieval; no embedding-provider API key required.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=32
RERANKER_MODEL=BAAI/bge-reranker-base

# Replace with a random private value before sharing/deploying the service.
STUDYMATE_SECRET_KEY=replace_with_a_random_private_value
# DATABASE_URL is optional; default is backend/chatbot.db (absolute path resolved in code).

# Optional LangSmith tracing / Admin telemetry. Disabled by default.
LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=Studymate

# Optional evaluation-only key separation; falls back to GROQ_API_KEY.
# GROQ_GENERATOR_API_KEY=your_groq_api_key_here
# GROQ_JUDGE_API_KEY=your_groq_api_key_here
